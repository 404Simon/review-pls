BETTER_AUTH_URL=https://review.example.com
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-48-output
REGISTRATION_CODE=replace-with-a-long-random-invite-code

# Required: contact address shown in the reviewer guide.
CONTACT_EMAIL=you@example.org

# Comma-separated accounts that are promoted to admin on every start, once
# they have registered. Promotion never demotes; see the README.
ADMIN_EMAILS=you@example.org
